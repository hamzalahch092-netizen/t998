import asyncio,os,time
import numpy as np,pandas as pd
import aiohttp

TOKEN=os.getenv("TG_TOKEN","")
EMAIL=os.getenv("PO_EMAIL","")
PWD=os.getenv("PO_PASS","")
ASSET=os.getenv("PO_ASSET","eurusd")
TF_M=int(os.getenv("PO_TF",5))
STAKE=float(os.getenv("PO_STAKE",0.20))
CONF_T=float(os.getenv("PO_CONF",0.76))
MAX_T=int(os.getenv("PO_MAXT",35))
MAX_DD=float(os.getenv("PO_MDX",0.25))
VOL_MIN=float(os.getenv("PO_VOL",12.0))
INIT_B=float(os.getenv("PO_BANK",50))
bank=INIT_B;n=0;cid=""

async def tg(t):
    if not cid:return
    try:
        async with aiohttp.ClientSession() as s:
            await s.post(f"https://api.telegram.org/bot{TOKEN}/sendMessage",
                json={"chat_id":cid,"text":t,"parse_mode":"HTML"})
    except:pass

async def check():
    global cid,bank,n
    try:
        async with aiohttp.ClientSession() as s:
            r=await s.get(f"https://api.telegram.org/bot{TOKEN}/getUpdates")
            j=(await r.json()).get("result",[])
            for m in j:
                msg=m["message"]["text"].strip()
                cid=m["chat"]["id"]
                if msg=="/start":
                    bank=INIT_B;n=0
                    await tg(f"TRADER99 ONLINE | ${bank:.2f} | {ASSET.upper()} {TF_M}m")
                elif msg=="/ping":
                    await tg(f"PONG | ${bank:.2f} | trades {n}/{MAX_T}")
                elif msg=="/balance":
                    await tg(f"${bank:.2f} | {n}/{MAX_T}")
                elif msg=="/stop":
                    await tg("STOPPED")
                    return False
                elif msg=="/restart":
                    bank=INIT_B;n=0
                    await tg(f"RESTARTED | ${bank:.2f}")
            return True
    except:return True

async def main():
    global cid
    while not cid:
        await check()
        await asyncio.sleep(2)
    while True:
        ok=await check()
        if not ok:break
        await asyncio.sleep(30)

asyncio.run(main())
